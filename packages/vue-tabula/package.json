{
  "name": "vue-tabula",
  "version": "0.2.0",
  "description": "Componente tabella dati avanzato per Vue 3: ordinamento, filtri, paginazione, virtualizzazione e accessibilità ARIA grid.",
  "keywords": [
    "vue",
    "vue3",
    "table",
    "data-table",
    "datagrid",
    "virtual-scroll",
    "aria-grid",
    "typescript",
    "vuejs",
    "grid",
    "sorting",
    "pagination",
    "accessible",
    "a11y",
    "ssr",
    "nuxt",
    "zero-dependencies"
  ],
  "license": "MIT",
  "author": "Francesco Chiaravalloti",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FraC2005/vue-tabula.git",
    "directory": "packages/vue-tabula"
  },
  "bugs": {
    "url": "https://github.com/FraC2005/vue-tabula/issues"
  },
  "homepage": "https://frac2005.github.io/vue-tabula/",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && node scripts/fix-dts.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:coverage": "vitest run --project unit --coverage",
    "check:package": "pnpm dlx publint && pnpm dlx @arethetypeswrong/cli --pack --profile esm-only --exclude-entrypoints ./style.css"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/browser": "^5.1.1",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/test-utils": "^2.6.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.14"
  }
}
